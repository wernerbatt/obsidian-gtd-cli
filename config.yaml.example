# Obsidian GTD CLI Configuration

# Path to the Obsidian CLI binary
# Linux/Mac: typically $(which obsidian) or /usr/local/bin/obsidian
# WSL:       /mnt/c/Users/<you>/AppData/Local/Programs/obsidian/Obsidian.exe
obsidian_bin: /usr/local/bin/obsidian

# Obsidian vault name (passed as vault= to CLI)
vault_name: MyVault

# Path to your Obsidian vault on disk (for git checks, etc.)
vault_path: /path/to/your/obsidian/vault

# GTD folder structure within vault
gtd:
  # Base GTD folder
  base_folder: GTD

  # Dashboard file with query views
  dashboard: GTD/Dashboard.md

  # Context files (for organizing next actions)
  contexts:
    pc_deep: GTD/PC - Deep Focus.md
    pc_quick: GTD/PC - Quick Wins.md
    pc_batch: GTD/PC - Batch Tasks.md
    work: GTD/Work.md
    home: GTD/Home.md
    sharne: GTD/Partner.md
    errands: GTD/Errands.md
    garden: GTD/Garden.md
    # Legacy - to be migrated to deep/quick/batch tags
    pc: GTD/PC.md
    # someday: GTD/Someday Maybe.md  # DEPRECATED: Use lowest priority (⏬) instead

  # Project folder and index
  projects_folder: GTD/Projects
  projects_list: GTD/Projects List.md

  # Checklists folder
  checklists_folder: GTD/Checklists
  weekly_review: GTD/Checklists/Weekly Review Checklist.md

  # Recurring tasks file
  recurring: GTD/Recurring.md

# Default settings
settings:
  # Create backups before modifying files (disabled - rely on git instead)
  create_backups: false

  # Default context tag if none specified
  default_context: "@pc"

  # Available context tags to suggest during processing
  available_contexts:
    - "@deep"      # Deep focus work (2+ hours, high concentration)
    - "@quick"     # Quick wins (<15 min, low effort)
    - "@read"      # Reading tasks
    - "@batch"     # Similar tasks to batch together
    # "@work" - retired
    # "@home" - retired, tasks reassigned to @quick/@partner/@out/@garden/@batch
    - "@partner"    # Requires your partner/collaborator
    - "@out"
    # "@garden" - retired, tasks reassigned to @out
    - "@ai"
    - "@ponderables"
    - "@stuck"
    # "@pc" - retired, migrated to @deep/@quick/@batch/@read

  # Note: @someday context is deprecated. Use lowest priority (⏬) for someday/maybe items instead.

# Google Calendar accounts (used by review skill + gccli)
calendars:
  account: user@example.com
  additional:
    - name: "Secondary Calendar"
      id: <your-calendar-id>@group.calendar.google.com
    - name: "Partner"
      id: partner@example.com
